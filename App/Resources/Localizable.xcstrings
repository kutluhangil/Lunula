    "onboarding.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notch becomes a small, quiet island: music, timers, meetings, weather and files, right where you look."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentiğin küçük ve sessiz bir adaya dönüşür: müzik, zamanlayıcı, toplantı, hava ve dosyalar tam baktığın yerde."
          }
        }
      }
    },
