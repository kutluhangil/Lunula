  "strings": {
    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunula, Müzik ve Spotify'da çalanı gösterir ve oynatmayı kontrol etmenizi sağlar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunula shows what's playing in Music and Spotify and lets you control playback."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunula, bir sonraki etkinliğinizi ve toplantılar için Katıl düğmesini gösterir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunula shows your next event and a Join button for meetings."
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunula, yerel hava durumunu göstermek için yaklaşık konumunuzu kullanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunula uses your approximate location to show local weather."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunula, yerel hava durumunu göstermek için yaklaşık konumunuzu kullanır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lunula uses your approximate location to show local weather."
          }
        }
      }
    }
  }
